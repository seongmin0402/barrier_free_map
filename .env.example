# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps — Dynamic Map (JavaScript 키)
# https://www.ncloud.com/product/applicationService/maps
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Google Cloud Text-to-Speech — 음성 길안내 TTS (서버 전용)
GOOGLE_TTS_API_KEY=

# 배포된 사이트 주소 (SEO: canonical/sitemap/robots에 사용). 끝에 / 없이 입력
NEXT_PUBLIC_SITE_URL=https://knu-bfmap.com

# 구글 서치 콘솔 HTML 태그 인증값 (meta content 값만)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 사이트 소유확인 HTML 태그 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
